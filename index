  <body>
    <header>
      <a href="#content">Перейти к основному содержанию</a>
      <h1 style="color: #1A40E7;">Осенняя коллекция</h1>
      <nav aria-label="Разделы страницы">
        <ul>
          <li><a href="#sale">Летняя распродажа</a></li>
